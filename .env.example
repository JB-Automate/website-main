# Copy to .env for local development. Never commit .env or real credentials.

# preview (default) keeps the site noindex and enquiry sending switched off.
SITE_MODE=preview

# Public site origin and visible contact address.
PUBLIC_SITE_URL=
PUBLIC_CONTACT_EMAIL=

# Server-only email delivery through Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Operator confirmations. Set only after the real work is done.
CONTACT_RATE_LIMIT_CONFIGURED=
PRIVACY_NOTICE_APPROVED=

# server (default) uses the endpoint and Resend. email_app is a static deployment
# where the form opens the visitor's own email application instead.
ENQUIRY_DELIVERY=server

# Optional enquiry copies. Leave empty to store nothing at all.
# Example for a local PostgreSQL server: postgres://postgres@127.0.0.1:5432/jb_automate
DATABASE_URL=
# Random value that salts the stored hashes. Change it and old hashes stop matching.
ENQUIRY_HASH_SALT=
