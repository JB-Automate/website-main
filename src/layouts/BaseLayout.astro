---
import "@fontsource-variable/manrope";
import "@fontsource-variable/kode-mono";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import kodeMonoLatin from "@fontsource-variable/kode-mono/files/kode-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteContent } from "../content/site";
import { siteConfig } from "../lib/site-config";

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = "JB Automate | AI built around your business",
  description = siteContent.description,
  isHome = true,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
const socialImageUrl = new URL("/images/social-card.png", siteConfig.url);
const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteContent.name,
  url: siteConfig.url,
  description: siteContent.description,
  email: siteConfig.hasPublicEmail ? siteConfig.email : undefined,
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f7f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={kodeMonoLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {siteConfig.isPreview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteContent.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!siteConfig.isPreview && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JB Automate. Put AI to work. On your terms." />
    <meta name="twitter:card" content="summary_large_image" />
    {!siteConfig.isPreview && <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationData).replace(/</g, "\\u003c")} />}
  </head>
  <body id="top" class:list={{ "home-page": isHome }}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header isHome={isHome} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
