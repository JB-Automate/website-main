---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import { siteContent } from "../content/site";

const { about } = siteContent;
---

<BaseLayout isHome={false} mainLabelledBy="about-heading">
  <article class="about-page">
    <header class="about-hero container">
      <p class="about-label">About JB Automate</p>
      <h1 id="about-heading">{about.heading[0]}<br /><span>{about.heading[1]}</span></h1>
      <p class="about-lead">{about.introduction}</p>
      <div class="about-actions">
        <a class="button button--primary" href="/#contact">Start a conversation<Icon name="diagonal" size={17} /></a>
        <a class="text-link" href="/workflow-automation/">Explore workflow automation<Icon name="arrow" size={17} /></a>
      </div>
    </header>

    <section class="about-principles">
      <div class="container about-grid">
        <article>
          <p class="about-number" aria-hidden="true">01</p>
          <h2>Start with the work.</h2>
          <p>{about.approach}</p>
        </article>
        <article>
          <p class="about-number" aria-hidden="true">02</p>
          <h2>Keep responsibility visible.</h2>
          <p>{about.responsibility}</p>
        </article>
      </div>
    </section>

    <section class="about-experience container" aria-labelledby="experience-heading">
      <div>
        <p class="about-label">Relevant experience</p>
        <h2 id="experience-heading">Practical AI work inside a real organization.</h2>
      </div>
      <div class="about-experience-copy">
        <p>{about.experience}</p>
        <p class="about-disclosure">{about.disclosure}</p>
      </div>
    </section>

    <section class="about-services container" aria-labelledby="about-services-heading">
      <p class="about-label">What we build</p>
      <h2 id="about-services-heading">Focused services for a useful first project.</h2>
      <div class="about-service-links">
        <a href="/custom-ai-apps/"><span>Custom AI applications</span><small>Focused tools built around your context and review requirements.</small><Icon name="arrow" size={20} /></a>
        <a href="/workflow-automation/"><span>Workflow automation</span><small>Connected steps that reduce manual handoffs while keeping people in control.</small><Icon name="arrow" size={20} /></a>
      </div>
    </section>

    <Contact />
  </article>
</BaseLayout>
