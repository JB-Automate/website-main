---
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { siteContent } from "../content/site";
import { siteConfig } from "../lib/site-config";
const { contact } = siteContent;
---

<section class="contact-section container" id="contact" aria-labelledby="contact-heading">
  <div class="contact-panel">
    <div class="contact-intro">
      <h2 id="contact-heading">{contact.heading[0]}<br />{contact.heading[1]}</h2>
      <p class="contact-description">{contact.description}</p>
      <p class="contact-next">{contact.nextStep}</p>
      <div class="contact-email"><a href={siteConfig.emailHref}>{siteConfig.email}<Icon name="diagonal" size={22} /></a></div>
    </div>
    <ContactForm />
  </div>
</section>
