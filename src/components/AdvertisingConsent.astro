---
import { consentScript } from "../lib/ads-scripts";
import { siteConfig } from "../lib/site-config";

---

{siteConfig.ads.enabled && (
  <aside class="consent-banner" data-consent-banner hidden aria-labelledby="consent-heading">
    <div>
      <strong id="consent-heading">Advertising measurement</strong>
      <p>With your permission, we use Google Ads measurement to understand whether an ad leads to an enquiry. <a href="/privacy/">Read the details.</a></p>
    </div>
    <div class="consent-actions">
      <button class="text-link" type="button" data-consent-choice="denied">No thanks</button>
      <button class="button button--small" type="button" data-consent-choice="granted">Allow measurement</button>
    </div>
  </aside>
)}

{siteConfig.ads.enabled && (
  <script is:inline set:html={consentScript} />
)}
