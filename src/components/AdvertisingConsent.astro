---
import { siteConfig } from "../lib/site-config";
---

{siteConfig.ads.enabled && (
  <aside class="consent-banner" data-consent-banner hidden aria-labelledby="consent-heading">
    <div>
      <strong id="consent-heading">Advertising measurement</strong>
      <p>With your permission, we use Google Ads measurement to understand whether an ad leads to an enquiry. <a href="/privacy/">Read the details.</a></p>
    </div>
    <div class="consent-actions">
      <button class="text-link" type="button" data-consent-choice="denied">No thanks</button>
      <button class="button button--small" type="button" data-consent-choice="granted">Allow measurement</button>
    </div>
  </aside>
)}

{siteConfig.ads.enabled && (
  <script is:inline define:vars={{ adsId: siteConfig.ads.id, conversionLabel: siteConfig.ads.conversionLabel }}>
    (() => {
      const storageKey = "jb-ads-consent";
      const attributionKey = "jb-ad-attribution";
      const allowedAttribution = ["gclid", "gbraid", "wbraid", "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
      const banner = document.querySelector("[data-consent-banner]");
      let loaded = false;

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      window.gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        wait_for_update: 500,
      });

      function rememberAttribution() {
        const params = new URLSearchParams(window.location.search);
        const existing = (() => {
          try { return JSON.parse(sessionStorage.getItem(attributionKey) || "{}"); }
          catch { return {}; }
        })();
        for (const key of allowedAttribution) {
          const value = params.get(key);
          if (value && value.length <= 500) existing[key] = value;
        }
        sessionStorage.setItem(attributionKey, JSON.stringify(existing));
      }

      function loadGoogleTag() {
        if (loaded) return;
        loaded = true;
        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(adsId)}`;
        document.head.append(script);
        window.gtag("js", new Date());
        window.gtag("config", adsId);
      }

      function applyChoice(choice) {
        localStorage.setItem(storageKey, choice);
        const granted = choice === "granted";
        window.gtag("consent", "update", {
          ad_storage: granted ? "granted" : "denied",
          ad_user_data: granted ? "granted" : "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
        });
        if (granted) {
          rememberAttribution();
          loadGoogleTag();
        } else {
          sessionStorage.removeItem(attributionKey);
        }
        if (banner) banner.hidden = true;
        window.dispatchEvent(new CustomEvent("jb:ads-consent", { detail: { choice } }));
      }

      let savedChoice = null;
      try { savedChoice = localStorage.getItem(storageKey); } catch {}
      if (savedChoice === "granted" || savedChoice === "denied") applyChoice(savedChoice);
      else if (banner) banner.hidden = false;

      banner?.querySelectorAll("[data-consent-choice]").forEach((button) => {
        button.addEventListener("click", () => applyChoice(button.dataset.consentChoice));
      });

      window.addEventListener("jb:lead-submitted", (event) => {
        let choice = null;
        try { choice = localStorage.getItem(storageKey); } catch {}
        if (choice !== "granted" || !event.detail?.email) return;
        loadGoogleTag();
        window.gtag("set", "user_data", { email: event.detail.email });
        window.gtag("event", "conversion", { send_to: `${adsId}/${conversionLabel}` });
      });
    })();
  </script>
)}
